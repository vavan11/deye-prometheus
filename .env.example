# ---------------------------------------------------
# Deye Exporter — Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
#
# Formatting: do NOT quote values, and avoid "$" in values. docker compose treats
# "$" as a variable (abc$def becomes abc) and `docker run --env-file` keeps quotes
# literally. For a credential containing "$", use the <NAME>_FILE form below.
# ---------------------------------------------------

# Where to scrape metrics from: "local" (Solarman V5 over LAN) or "cloud" (Deye Cloud API).
# Both produce identical deye_* metric names; only one runs per process.
DEYE_SOURCE=local

# ---------------------------------------------------
# LOCAL source — Solarman V5 / Modbus over your LAN
# ---------------------------------------------------

# IP address of the Solarman Wi-Fi data logger
INVERTER_IP=192.168.1.100

# Serial number printed on the Wi-Fi data logger (NOT the inverter serial)
INVERTER_SERIAL=1234567890

# Modbus TCP port (almost always 8899)
INVERTER_PORT=8899

# Modbus slave ID of the inverter (almost always 1)
INVERTER_MB_SLAVE_ID=1

# ---------------------------------------------------
# CLOUD source — Deye Cloud OpenAPI
# Requires an approved app at https://developer.deyecloud.com/app
# ---------------------------------------------------

# Regional endpoint: eu1 for Europe, us1 for the Americas
CLOUD_BASE_URL=https://eu1-developer.deyecloud.com/v1.0

# App credentials from the Deye developer portal
CLOUD_APP_ID=
CLOUD_APP_SECRET=

# Your deyecloud.com account login (the password is SHA-256 hashed before it is sent)
CLOUD_EMAIL=
CLOUD_PASSWORD=

# Any of CLOUD_APP_ID / CLOUD_APP_SECRET / CLOUD_EMAIL / CLOUD_PASSWORD can instead be
# read from a file — the Docker secrets / Kubernetes secret-volume pattern:
# CLOUD_PASSWORD_FILE=/run/secrets/deye_password

# 0 = personal account. For a business member, get the ID from /v1.0/account/info
CLOUD_COMPANY_ID=0

# The INVERTER's serial — a different value from INVERTER_SERIAL above, which is the
# logger's. Find it with: python main.py --list-devices
CLOUD_DEVICE_SN=

# Expose measure points that aren't in cloud_parameters.py as deye_cloud_<key> gauges.
# Off by default so cloud mode emits exactly the same metric names as local mode.
CLOUD_EXPOSE_UNMAPPED=false

# Where to cache the access token (~60 day lifetime) so restarts don't re-authenticate.
# In Docker set this to /data/token.json — the default path is inside the read-only /app.
CLOUD_TOKEN_CACHE=.deye_token.json

# HTTP timeout for cloud calls, seconds
CLOUD_TIMEOUT=20

# ---------------------------------------------------
# Exporter Settings
# ---------------------------------------------------

# Port to expose Prometheus metrics and probe endpoints on
EXPORTER_PORT=9105

# Listen address. 0.0.0.0 is required inside a container; on a bare host where
# Prometheus runs locally, 127.0.0.1 keeps /metrics off the network.
EXPORTER_BIND=0.0.0.0

# Seconds between polls. Note: cloud data only refreshes at the logger's upload
# cadence (~5 min), so deye_data_timestamp_seconds shows the reading's true age.
POLL_INTERVAL=60

# ---------------------------------------------------
# Kubernetes probes (/readyz, /healthz) — defaults scale with POLL_INTERVAL
# ---------------------------------------------------

# /readyz fails after this many seconds without a SUCCESSFUL poll
# (default: max(3 x POLL_INTERVAL, 180))
# PROBE_READY_MAX_AGE=180

# /healthz fails after this many seconds without a poll ATTEMPT — i.e. the loop is
# wedged. Keep well above POLL_INTERVAL plus a slow poll (default: max(5 x POLL_INTERVAL, 300))
# PROBE_LIVE_MAX_STALL=300
